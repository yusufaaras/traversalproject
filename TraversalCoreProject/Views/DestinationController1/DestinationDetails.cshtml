@model EntityLayer.Concrete.Destination_yerler
@{
    ViewData["Title"] = "DestinationDetails";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
<!doctype html>
<html lang="zxx">

<body>
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">Tur Detayları</h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Default/Index/">Ana Sayfa</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Rehberin Yorumları </li>
                </ul>
            </div>
        </div>
    </section>
    <section class="blog-post-main w3l-homeblock1">
        <div class="blog-content-inf py-5">
            <div class="container pb-lg-4">
                
                <div class="single-post-image">
                    <div class="post-content">
                        @* Yükseklik kaldırıldı, max-width ile sınırlandı. Resim kendi oranını korur *@
                        <img src="@Model.CoverImage" style="max-width:100%; height: auto; display: block; margin: 0 auto;" class="radius-image img-fluid mb-5" alt="Kapak Görseli" />
                    </div>
                </div>

                <div class="single-post-content">
                    <p class="alphabet mb-4">
                        <span class="big-letter"></span>@Model.Details1
                    </p>
                    
                    <blockquote class="blockquote my-5">
                        <div class="icon-quote"><span class="fa fa-quote-left" aria-hidden="true"></span></div>
                        Bu Turda Ben Eşlik Edeceğim
                        <footer class="blockquote-footer mt-3">
                            @Model.Guide.Name
                        </footer>
                    </blockquote>

                    <div class="sing-post-thumb mb-5 row pt-3">
                        @* Yan yana duran resimlerde de yükseklik zorlaması kaldırıldı *@
                        <div class="col-sm-6">
                            <a href="#url"><img src="@Model.Image" style="width:100%; height:auto;" class="img-fluid radius-image" alt=""></a>
                        </div>
                        <div class="col-sm-6 mt-sm-0 mt-3">
                            <a href="#url"><img src="@Model.Image2" style="width:100%; height:auto;" class="img-fluid radius-image" alt=""></a>
                        </div>
                    </div>

                    <h3 class="blog-desc-big m-0 mb-lg-4 mb-3">Turun Detaylı Açıklaması</h3>
                    <p class="mb-4">
                        @Model.Details2
                    </p> 

                    <div class="d-grid left-right mt-5 pb-md-5">
                        <div class="buttons-singles tags">
                            <h4>Etiketler :</h4>
                            <a href="#blog-tag">Seyahat</a>
                            <a href="#blog-tag">Gezi</a>
                            <a href="#blog-tag">Tur</a>
                            <a href="#blog-tag">Dünya</a>
                        </div>
                        <div class="buttons-singles">
                            <h4>Paylaş :</h4>
                            <a href="#blog-share"><span class="fa fa-facebook" aria-hidden="true"></span></a>
                            <a href="#blog-share"><span class="fa fa-twitter" aria-hidden="true"></span></a>
                            <a href="#blog-share"><span class="fa fa-google-plus" aria-hidden="true"></span></a>
                        </div>
                    </div>

                    <div class="author-card mt-5" style="background: #f8f9fa; padding: 30px; border-radius: 15px;">
                        <div class="row align-items-center">
                            <div class="col-sm-3 col-12 text-center">
                                <img src="@Model.Guide.Image" alt="@Model.Guide.Name" 
                                     style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #ff6600;" 
                                     class="rounded-circle img-fluid">
                            </div>
                            <div class="col-sm-9 mt-sm-0 mt-3">
                                <h3 class="mb-2 title" style="font-weight: 700; color: #333;">@Model.Guide.Name</h3>
                                <h6 class="mb-3" style="color: #ff6600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">Profesyonel Rehber</h6>
                                <p style="line-height: 1.7; color: #666;">
                                    @Model.Guide.Description
                                </p> 
                            </div>
                        </div>
                    </div>
                    <div class="mt-5">
                        @await Component.InvokeAsync("_CommentList", new { id = ViewBag.i })
                        @await Html.PartialAsync("~/Views/Comment/AddComment.cshtml", new { id = ViewBag.destID })
                    </div>
                    
                </div>
            </div>
        </div>
    </section>
</body>
</html>
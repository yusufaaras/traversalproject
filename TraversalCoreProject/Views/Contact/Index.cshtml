@model DTOLayer.DTOS.ContactDTOs.SendMessageDTO
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
<section class="w3l-about-breadcrumb text-left">
    <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
        <div class="container py-2">
            <h2 class="title">Bize Ulaşın</h2>
            <ul class="breadcrumbs-custom-path mt-2">
                <li><a href="/Default/Index/">Ana Sayfa</a></li>
                <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> İletişim Sayfası </li>
            </ul>
        </div>
    </div>
</section>

<section class="w3l-contact" id="contact">
    <div class="contact-infubd py-5">
        <div class="container py-lg-3">
            <div class="contact-grids row">
                <div class="col-lg-6 contact-left">
                    <div class="partners">
                        <div class="cont-details">
                            <h5>İletişim Bilgilerimiz</h5>
                            <p class="mt-3 mb-4">
                                Merhaba sevgili gezgin, bize 7/24 iletişim ağları üzerinden ulaşabilirsin.
                            </p>
                        </div>
                        <div class="hours">
                            <h6 class="mt-4">Mail Adresimiz:</h6>
                            <p>
                                <a href="mailto:info@vhbtravel.com">
                                    info@vhbtravel.com
                                </a>
                            </p>
                            <h6 class="mt-4">Ofis:</h6>
                            <p> Cennet Mah.Hürriyet Cad. A ve B Blokları Barış Apt. No:13/6 Küçükçekmece / İSTANBUL </p>
                            
                            <h6 class="mt-4"><span class="mt-4"></span>Numara:</h6>
                            <p class="margin-top">
                                <span class="fa fa-phone mr-2"></span><a href="tel:+905350147693">+90 535 014 76 93</a>
                            </p>
                            <p class="margin-top">
                                <span class="fa fa-phone mr-2"></span><a href="tel:+905378473214">+90 537 847 32 14</a>
                            </p>
                            <p class="margin-top">
                                <span class="fa fa-phone mr-2"></span><a href="tel:+905449170045">+90 544 917 00 45</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mt-lg-0 mt-5 contact-right">
                    <form id="contactForm" class="signin-form">
                        <div class="input-grids">
                            <div class="form-group">
                                <input type="text" id="nameInput" placeholder="Adınız*" class="contact-input" required />
                            </div>
                            <div class="form-group">
                                <input type="email" id="emailInput" placeholder="Mail Adresiniz*" class="contact-input" required />
                            </div>
                            <div class="form-group">
                                <input type="text" id="subjectInput" placeholder="Konu*" class="contact-input" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <textarea id="messageInput" placeholder="Mesajınızı Yazabilirsiniz*" required></textarea>
                        </div>
                        <div class="text-right">
                            <button type="button" onclick="sendMail()" class="btn btn-style btn-primary">Mesajı Gönder</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="map mt-5 pt-md-5">
                <h5>Yerimiz</h5>
                <iframe src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3011.602256425977!2d28.776962576551693!3d40.99023397135311!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zNDDCsDU5JzI0LjgiTiAyOMKwNDYnNDcuMSJF!5e0!3m2!1str!2str!4v1716480000000!5m2!1str!2str"
                        style="border:0; width:100%; height:450px;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>

<script>
    function sendMail() {
        var name = document.getElementById('nameInput').value;
        var subject = document.getElementById('subjectInput').value;
        var message = document.getElementById('messageInput').value;
        
        if(!name || !subject || !message) {
            alert("Lütfen tüm alanları doldurun.");
            return;
        }

        var body = "Gönderen: " + name + "\n\n" + message;
        var mailtoLink = "mailto:info@vhbtravel.com?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
        
        window.location.href = mailtoLink;
    }
</script>
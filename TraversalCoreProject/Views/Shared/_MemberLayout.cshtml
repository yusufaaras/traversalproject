@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localaizer

@{
    Layout = null;
}

<!DOCTYPE html>
@await Component.InvokeAsync("_MemberLayoutHead")
<html class="loading" lang="en" data-textdirection="ltr">
<body class="vertical-layout vertical-menu 2-columns menu-expanded fixed-navbar" data-open="click" data-menu="vertical-menu" data-color="bg-gradient-x-purple-blue" data-col="2-columns">

    <!-- fixed-top-->
    <nav class="header-navbar navbar-expand-md navbar navbar-with-menu navbar-without-dd-arrow fixed-top navbar-semi-light">
        <div class="navbar-wrapper">
            <div class="navbar-container content">
                <div class="collapse navbar-collapse show" id="navbar-mobile">

                    @* Arama / Dil / Navbar bileşenlerini oturumluysa çağırıyoruz (anonim kullanıcı çağırmaz) *@
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        @await Component.InvokeAsync("_MemberLayoutSerach")
                        @await Component.InvokeAsync("_MemberLayoutLanguages")
                        @await Component.InvokeAsync("_MemberLayoutNavbar")
                    }
                    else
                    {
                        @* Eğer anonim iseniz isterseniz burada basit linkler gösterebilirsiniz *@
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("SignIn","Login")">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("SignUp","Login")">Kayıt Ol</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow" data-scroll-to-active="true" data-img="~/member/theme-assets/images/backgrounds/02.jpg">
        <div class="navbar-header">
            <ul class="nav navbar-nav flex-row">
                <li class="nav-item mr-auto">
                    <h1>
                        <a class="navbar-brand mr-lg-5" href="@Url.Action("Index","Default")">
                            <img src="@Url.Content("~/Logo.png")" alt="VhbCıtyTourism" class="brand-logo" style="height:90px; width:auto;" />
                        </a>
                    </h1>
                </li>
                <li class="nav-item d-md-none"><a class="nav-link close-navbar"><i class="ft-x"></i></a></li>
            </ul>
        </div>

        <div class="main-menu-content">
            <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <li class="nav-item">
                        <a href="/Member/DashBoard/MemberDashboard/"><i class="ft-home"></i><span class="menu-title">Ana Sayfa</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Profile/Index/"><i class="ft-pie-chart"></i><span class="menu-title">@localaizer["Profilim"]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Destination/GetCitiesSerachByName/"><i class="ft-navigation-2"></i><span class="menu-title">@localaizer["Rota Ara"]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Reservation/MyCurrentReservation/"><i class="ft-droplet"></i><span class="menu-title">@localaizer["Aktif Rezv."]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Reservation/MyOldReservation/"><i class="ft-clock"></i><span class="menu-title">@localaizer["Geçmiş Rezv."]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Reservation/MyApprovalReservation/"><i class="ft-cloud"></i><span class="menu-title">@localaizer["Bekleyen Rezv."]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Reservation/NewReservation/"><i class="ft-navigation"></i><span class="menu-title">@localaizer["Yeni Rezervasyon"]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/Destination/Index/"><i class="ft-map"></i><span class="menu-title">@localaizer["Tur Rotaları"]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="/Member/LastDestinations/Index/"><i class="ft-navigation-2"></i><span class="menu-title">@localaizer["Son Rotalar"]</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index","Default")"><i class="ft-activity"></i><span class="menu-title">@localaizer["Siteye Git"]</span></a>
                    </li>

                    @* Çıkış: istemci tarafı token temizle ve sonra sunucu logout (LoginController.LogOut GET) çağrısı *@
                    <li class="nav-item">
                        <a href="javascript:void(0);" class="nav-link" onclick="logoutAndRedirect();">
                            <i class="ft-power"></i><span class="menu-title">@localaizer["Çıkış Yap"]</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a href="@Url.Action("SignIn","Login")"><i class="ft-user"></i><span class="menu-title">Giriş Yap</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("SignUp","Login")"><i class="ft-user-plus"></i><span class="menu-title">Kayıt Ol</span></a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index","Default")"><i class="ft-activity"></i><span class="menu-title">Siteye Git</span></a>
                    </li>
                }
            </ul>
        </div>

        <div class="navigation-background"></div>
    </div>

    <div class="app-content content">
        <div class="content-wrapper">
            <div class="content-wrapper-before"></div>

            @* Header content bileşenini yalnızca oturumlu kullanıcı için çağırıyoruz (anonim çağırmayalım) *@
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                @await Component.InvokeAsync("_MemberLayoutHeaderContent")
            }

            <div class="content-body">
                @RenderBody()
            </div>
        </div>
    </div>

    @* Footer component çağırısını herkes için bırakıyorum; değiştirmek isterseniz sarabilirsiniz *@
    @await Component.InvokeAsync("_MemberLayoutFooter")

    <script src="~/member/theme-assets/vendors/js/vendors.min.js" type="text/javascript"></script>
    <script src="~/member/theme-assets/js/core/app-menu-lite.js" type="text/javascript"></script>
    <script src="~/member/theme-assets/js/core/app-lite.js" type="text/javascript"></script>

    <script>
        // logout: temizle client-side tokenları (yaygın anahtarlar) ve yönlendir sunucu logout endpoint'ine
        function logoutAndRedirect() {
            try {
                // yaygın token anahtarlarını temizle (projenizde farklı ise ekleyin)
                localStorage.removeItem('token');
                localStorage.removeItem('accessToken');
                localStorage.removeItem('authToken');
                sessionStorage.removeItem('token');
                sessionStorage.removeItem('accessToken');
            } catch (e) {
                console.warn('local/session storage temizlenirken hata:', e);
            }

            // Sunucu tarafında SignOut çalıştıracak olan LogOut endpoint'ine GET ile yönlendiriyoruz
            // Controller'da GET LogOut varsa bu çalışır; önerilen daha güvenli yöntem POST ise controller'ı POST destekleyecek şekilde güncelleyin.
            window.location.href = '@Url.Action("LogOut","Login")';
        }
    </script>
</body>
</html>
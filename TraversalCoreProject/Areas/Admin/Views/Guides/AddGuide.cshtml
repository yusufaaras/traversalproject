@model EntityLayer.Concrete.Guide
@{
    ViewData["Title"] = "AddGuide";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h1>Yeni Rehber Oluşturma Sayfası</h1>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Ad Soyad</label>
        <input type="text" asp-for="Name" class="form-control" />
    </div>
    <br />
    <div class="form-group">
        <label>Rehber Fotoğrafı (Dosya Yükle)</label>
        <input type="file" name="ImageFile" class="form-control" />
        <small class="text-muted">Veya aşağıya görsel URL'si yapıştırın.</small>
    </div>
    <br />
    <div class="form-group">
        <label>Rehber Fotoğraf URL</label>
        <input type="text" asp-for="Image" class="form-control" placeholder="https://..." />
    </div>
    <br />
    <div class="form-group">
        <label>Açıklama</label>
        <textarea cols="30" rows="5" class="form-control" asp-for="Description"></textarea>
    </div>
    <br />
    <button class="btn btn-outline-primary">Oluştur</button>
</form>
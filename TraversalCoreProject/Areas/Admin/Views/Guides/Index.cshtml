@using EntityLayer.Concrete
@model List<Guide>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    img {
        border-radius: 50%;
    }
</style>

<h1>Rehber Listesi</h1>

<a href="/Admin/Guides/AddGuide" class="btn btn-outline-primary">Yeni Rehber Ekle</a>
<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Ad Soyad</th>
        <th>Açıklama</th>   
        <th>Sil</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image" height="50" width="50" style="object-fit: cover;" />
                }
                else
                {
                    <img src="/Login_v1/images/img-01.png" height="50" width="50" /> }
            </td>
            <td>@item.Name</td>
            <td>@item.Description</td> 
            <td><a href="/Admin/Guides/DeleteGuide/@item.GuideId" class="btn btn-outline-danger"
                   onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a></td>
        </tr>
    }
</table>

<style>
    .item-container {
        display: flex;
        align-items: center;
    }

    .aktif-item {
        color: deepskyblue
    }

    .pasif-item {
        color: orange;
    }
</style>
@using EntityLayer.Concrete
@model List<Destination_yerler>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Tur Rotaları</h1>
<table class="table table-bordered">
    <div class="mb-3">
        <a href="/Admin/Destination/AddDestination" class="btn btn-outline-primary">Yeni Tur Rotası</a>
    </div>
    <thead>
        <tr>
            <th>#</th>
            <th>Şehir</th>
            <th>Tur Tarihi</th> @* --- TARİH KOLONU EKLENDİ --- *@
            <th>Fiyat</th>
            <th>Özellikler</th>
            <th>Aktiviteler</th>
            <th>Kapasite</th>
            <th>Sitede Gör</th>
            <th>Sil</th> 
            <th>Güncelle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DestinationId</td>
                <td>@item.City</td>
                <td>@item.Date.ToString("dd.MM.yyyy HH:mm")</td> @* --- TARİH FORMATINDA GÖSTERİM --- *@
                <td>@item.Price $</td>
                
                <td>
                    @if (item.Features != null && item.Features.Any())
                    {
                        @* text-dark sınıfı metni siyah yapar *@
                        <span class="badge badge-info text-dark" title="@string.Join(", ", item.Features)">
                            @item.Features.Count Özellik
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">Yok</span>
                    }
                </td>

                <td>
                    @if (item.Activity != null && item.Activity.Any())
                    {
                        @* text-dark sınıfı metni siyah yapar *@
                        <span class="badge badge-success text-dark" title="@string.Join(", ", item.Activity)">
                            @item.Activity.Count Aktivite
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">Yok</span>
                    }
                </td>

                <td>@item.Capacity</td>
                <td><a href="/DestinationController1/DestinationDetails/@item.DestinationId" class="btn btn-outline-info btn-sm">Sitede Gör</a></td>
                <td><a href="/Admin/Destination/DeleteDestination/@item.DestinationId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a></td>
                <td><a href="/Admin/Destination/UpdateDestination/@item.DestinationId" class="btn btn-outline-success btn-sm">Güncelle</a></td>
            </tr>    
        }
    </tbody>
</table>